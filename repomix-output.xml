/* Week 7 additions */
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
}
.btn-small {
  width: auto;
  padding: 0.4rem 0.8rem;
}
.dash-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 1rem;
  margin-top: 1rem;
  align-items: start;
