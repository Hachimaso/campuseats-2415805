// One row in the cart. It shows data and reports clicks upward; it owns no state.
function CartItem({ line, onChangeQty, onRemove }) {
  const { item, qty } = line;
  return (
    <li className="cart-line">
      <div>
        <p className="cart-name">{item.name}</p>
        <p className="muted">RM {item.price.toFixed(2)} each</p>
      </div>
      <div className="qty">
        <button type="button" onClick={() => onChangeQty(item.id, -1)}>
          −
        </button>
        <span>{qty}</span>
        <button
          type="button"
          onClick={() => {
            onChangeQty(item.id, 1);
          }}
        >
          +
        </button>
      </div>
      <p className="line-total">RM {(item.price * qty).toFixed(2)}</p>
      <button
        type="button"
        className="link danger"
        onClick={() => {onRemove(item.id)}}
      >
        Remove
      </button>
    </li>
  );
}
export default CartItem;
</file>

<file path="src/components/CartPage.jsx">
import CartItem from "./CartItem.jsx";
import CheckoutForm from "./CheckoutForm.jsx";
function CartPage({ cart, onChangeQty, onRemove, onPlaceOrder }) {
  if (cart.length === 0) {
    return (
      <p className="muted">
        Your cart is empty. Pick something from a menu first.
      </p>
    );
  }
  const total = cart.reduce((sum, line) => sum + line.item.price * line.qty, 0);
  return (
    <div className="cart-layout">
      <div className="card">
        <ul className="cart-list">
          {cart.map((line) => (
            <CartItem
              key={line.item.id}
              line={line}
              onChangeQty={onChangeQty}
              onRemove={onRemove}
            />
          ))}
        </ul>
        <p className="cart-total">Total: RM {total.toFixed(2)}</p>
      </div>
      <CheckoutForm onPlaceOrder={onPlaceOrder} />
    </div>
  );
}
export default CartPage;
</file>

