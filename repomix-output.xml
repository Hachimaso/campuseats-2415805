@media (max-width: 720px) {
  .dash-grid {
    grid-template-columns: 1fr;
  }
}
.photo {
  width: 100%;
  height: 140px;
  object-fit: cover;
  border-radius: 8px;
  margin-bottom: 0.5rem;
}

/* Week 10: service worker messages */
.toast {
  position: fixed;
  right: 1rem;
  bottom: 1rem;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 0.75rem;
