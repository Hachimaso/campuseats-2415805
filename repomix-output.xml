.container a.card {
  color: inherit;
}

/* Week 5 additions */
.auth-page {
  max-width: 420px;
  margin: 2rem auto;
}
.auth-page h2 {
  margin: 0 0 0.5rem;
}
.btn-outline {
  background: #fff;
  color: var(--green);
  border: 1px solid var(--green);
  margin-top: 0.5rem;
}
.user-name {
  opacity: 0.9;
  font-size: 0.9rem;
