/* Week 9: an installable app must fit a phone screen */
@media (max-width: 640px) {
  .header {
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
  }
  .nav {
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: 0.95rem;
  }
